# 本地构建/部署配置 —— 复制为 config.env 并按实际路径修改
# config.env 已被 .gitignore 忽略，不会提交（可安全填写真实 IP/路径）

# ---- 基线 SDK 路径（视觉/C 组件交叉编译需要）----
# Sipeed 基线 SDK（含 middleware/v2、linux_5.10、buildroot 产物）
SDK=/home/sbh/ws/LicheeRV/LicheeRV-Nano-Build
# 官方 TPU SDK（tpu-sdk-sg200x，含 include/ 与 lib/*-static.a）
TPUSDK=/home/sbh/ws/LicheeRV/tpu-sdk/tpu-sdk

# ---- Android SDK（构建安卓发现 APP 需要）----
ANDROID_SDK=$HOME/android-sdk

# ---- 交叉编译工具链 ----
CXX=$HOME/toolchains/riscv64-linux-musl-x86_64/bin/riscv64-unknown-linux-musl-g++
export CC_riscv64gc_unknown_linux_musl=$HOME/toolchains/riscv64-linux-musl-x86_64/bin/riscv64-unknown-linux-musl-gcc
export AR_riscv64gc_unknown_linux_musl=$HOME/toolchains/riscv64-linux-musl-x86_64/bin/riscv64-unknown-linux-musl-ar

# ---- 板子地址（部署用；DHCP 会漂移）----
BOARD_IP=10.0.0.1
