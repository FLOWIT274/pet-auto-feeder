diff --git a/osdrv/interdrv/v2/cif/chip/mars/cif.c b/osdrv/interdrv/v2/cif/chip/mars/cif.c
index 539878a3a..aabdad2fc 100644
--- a/osdrv/interdrv/v2/cif/chip/mars/cif.c
+++ b/osdrv/interdrv/v2/cif/chip/mars/cif.c
@@ -2873,10 +2873,44 @@ static int _init_resource(struct platform_device *pdev)
 		if (gpio_request(link->snsr_rst_pin, "snsr-rst-gpio"))
 			return 0;
 
+		/* Keep the sensor reset pad hi-z (input) by default so an
+		 * external supply can drive it (LicheeRV Nano cam bring-up).
+		 * Only explicit ioctl RESET/UNRESET switches it to output. */
+		gpio_direction_input(link->snsr_rst_pin);
+
 		dev_info(&pdev->dev, "rst_pin = %d, pol = %d\n",
 			link->snsr_rst_pin, link->snsr_rst_pol);
 	}
 
+	/* power-en pin (e.g. MIPIRX0N/XGPIOC_10 on LicheeRV Nano):
+	 * switch FUNCSEL away from CAM_MCLK1 clock output and keep the
+	 * pad hi-z (input) for external 3.3V driving. */
+	for (i = 0; i < MAX_LINK_NUM; ++i) {
+		link = &dev->link[i];
+		link->snsr_pwr_pin = of_get_named_gpio_flags(pdev->dev.of_node,
+				"power-en-gpio", i, &link->snsr_pwr_pol);
+		if (link->snsr_pwr_pin < 0)
+			break;
+
+		if (gpio_request(link->snsr_pwr_pin, "snsr-pwr-gpio"))
+			return 0;
+
+		gpio_direction_input(link->snsr_pwr_pin);
+
+		dev_info(&pdev->dev, "pwr_pin = %d, pol = %d\n",
+			link->snsr_pwr_pin, link->snsr_pwr_pol);
+	}
+	/* MIPIRX0N: CAM_MCLK1 (func 5) -> XGPIOC_10 (func 3) so the pad
+	 * stops driving the MCLK clock and becomes a plain hi-z GPIO. */
+	{
+		void __iomem *pinmux = ioremap(0x03001000, 0x1000);
+
+		if (pinmux) {
+			writel(0x3, pinmux + 0x18C);
+			iounmap(pinmux);
+		}
+	}
+
 	/* sw reset */
 	link = &dev->link[0];
 	link->phy_reset = devm_reset_control_get(&pdev->dev, "phy0");
