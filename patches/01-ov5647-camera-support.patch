+	ov5647_write_register(ViPipe, 0x3034, 0x08);
+	ov5647_write_register(ViPipe, 0x3106, 0xf5);
+	/* ---- RK ov5647_1296x972 ---- */
+	ov5647_write_register(ViPipe, 0x3035, 0x21);	/* PLL */
+	ov5647_write_register(ViPipe, 0x3036, 0x64);	/* PLL: RK3399=0x60@24MHz MCLK → 25MHz 晶振换算(×25/24) */
+	ov5647_write_register(ViPipe, 0x3037, 0x11);	/* PLL root div: 复位默认 0x03 错误,须 0x11(同 1080p) */
+	ov5647_write_register(ViPipe, 0x303c, 0x11);	/* PLL */
+	ov5647_write_register(ViPipe, 0x3821, 0x07);	/* ISP mirror on, Sensor mirror on, H bin on */
+	ov5647_write_register(ViPipe, 0x3820, 0x41);	/* ISP flip off, Sensor flip off, V bin on */
+	ov5647_write_register(ViPipe, 0x3612, 0x59);	/* analog control */
+	ov5647_write_register(ViPipe, 0x3618, 0x00);	/* analog control */
+	ov5647_write_register(ViPipe, 0x380c, 0x07);	/* HTS = 1896 */
+	ov5647_write_register(ViPipe, 0x380d, 0x68);	/* HTS */
+	ov5647_write_register(ViPipe, 0x380e, 0x05);	/* VTS = 1420 */
+	ov5647_write_register(ViPipe, 0x380f, 0x8c);	/* VTS */
+	ov5647_write_register(ViPipe, 0x3814, 0x31);	/* X INC */
+	ov5647_write_register(ViPipe, 0x3815, 0x31);	/* X INC */
+	ov5647_write_register(ViPipe, 0x3708, 0x64);	/* analog control */
+	ov5647_write_register(ViPipe, 0x3709, 0x52);	/* analog control */
+	ov5647_write_register(ViPipe, 0x3808, 0x05);	/* DVPHO = 1296 */
+	ov5647_write_register(ViPipe, 0x3809, 0x10);	/* DVPHO */
+	ov5647_write_register(ViPipe, 0x380a, 0x03);	/* DVPVO = 972 */
+	ov5647_write_register(ViPipe, 0x380b, 0xcc);	/* DVPVO */
+	ov5647_write_register(ViPipe, 0x3800, 0x00);	/* X Start */
+	ov5647_write_register(ViPipe, 0x3801, 0x08);	/* X Start */
+	ov5647_write_register(ViPipe, 0x3802, 0x00);	/* Y Start */
+	ov5647_write_register(ViPipe, 0x3803, 0x02);	/* Y Start */
+	ov5647_write_register(ViPipe, 0x3804, 0x0a);	/* X End */
+	ov5647_write_register(ViPipe, 0x3805, 0x37);	/* X End */
+	ov5647_write_register(ViPipe, 0x3806, 0x07);	/* Y End */
+	ov5647_write_register(ViPipe, 0x3807, 0xa1);	/* Y End */
+	/* banding filter */
+	ov5647_write_register(ViPipe, 0x3a08, 0x01);	/* B50 */
+	ov5647_write_register(ViPipe, 0x3a09, 0x27);	/* B50 */
+	ov5647_write_register(ViPipe, 0x3a0a, 0x00);	/* B60 */
+	ov5647_write_register(ViPipe, 0x3a0b, 0xf6);	/* B60 */
+	ov5647_write_register(ViPipe, 0x3a0d, 0x04);	/* B60 max */
+	ov5647_write_register(ViPipe, 0x3a0e, 0x03);	/* B50 max */
+	ov5647_write_register(ViPipe, 0x4004, 0x02);	/* black line number */
+	ov5647_write_register(ViPipe, 0x4837, 0x24);	/* MIPI pclk period */
+	ov5647_write_register(ViPipe, 0x0100, 0x01);
+
+	ov5647_default_reg_init(ViPipe);
+
+	delay_ms(100);
+
+	printf("ViPipe:%d,===OV5647 1296x972 25fps 10bit LINE Init OK!\n", ViPipe);
+}
