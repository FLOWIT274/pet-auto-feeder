#! /bin/sh
# S98wifiguard — 无线白名单守卫
# 板子只允许连接 /boot/wifi.ssid 指定的 WiFi；白名单外网络一律禁止自动连接。
# 1) 启动时确保 /etc/wpa_supplicant.conf 为纯净配置（单 network + update_config=0）
# 2) 每 10s 校验一次：出现白名单外 network（含无 ssid 的任意连接块）→ 重建并重启 WiFi
# 日志: /var/log/wifiguard.log

WPA=/etc/wpa_supplicant.conf
SSID_FILE=/boot/wifi.ssid
PASS_FILE=/boot/wifi.pass
LOG=/var/log/wifiguard.log
INTERVAL=${WIFIGUARD_INTERVAL:-10}

log() { echo "$(date "+%Y-%m-%d %H:%M:%S") $1" >> "$LOG"; echo "$1"; }

regen() {
	ssid=$(cat "$SSID_FILE" 2>/dev/null)
	[ -z "$ssid" ] && return 1
	pass=$(cat "$PASS_FILE" 2>/dev/null)
	{
		echo "ctrl_interface=/var/run/wpa_supplicant"
		echo "update_config=0"
		if [ -n "$pass" ]
		then
			wpa_passphrase "$ssid" "$pass" | grep -v "^[[:space:]]*#psk="
		else
			echo "network={"
			echo "	ssid=\"$ssid\""
			echo "	key_mgmt=NONE"
			echo "}"
		fi
	} > "$WPA" 2>/dev/null
	return 0
}

# 校验：所有 ssid= 均等于白名单，network 块 ≤1，且不存在无 ssid 的 network 块
check() {
	[ -f "$WPA" ] || return 1
	expected=$(cat "$SSID_FILE" 2>/dev/null)
	[ -z "$expected" ] && return 0   # 无白名单（AP 模式）不干预
	# 1) 每个 network 块的 ssid 必须等于白名单
	for s in $(sed -n "s/^[[:space:]]*ssid=\"\(.*\)\"/\1/p" "$WPA"); do
		[ "$s" = "$expected" ] || return 1
	done
	# 2) network 块数量 ≤ 1
	[ "$(grep -c "^network={" "$WPA" 2>/dev/null)" -le 1 ] || return 1
	# 3) 每个 network 块必须含 ssid（无 ssid 的块 = 任意连接）
	blocks=$(grep -c "^network={" "$WPA" 2>/dev/null)
	ssids=$(sed -n "s/^[[:space:]]*ssid=.*/x/p" "$WPA" | wc -l)
	[ "$blocks" -le "$ssids" ] || return 1
	# 4) 禁止 update_config=1（防止运行时新网络被写回配置文件持久化）
	grep -q "^[[:space:]]*update_config[[:space:]]*=[[:space:]]*1" "$WPA" && return 1
	return 0
}

start() {
	# 启动时无条件重建纯净配置（保证 update_config=0 + 单 network + 无明文 psk 注释）
	if [ -f "$SSID_FILE" ] && regen; then
		log "启动重建纯净配置 (ssid=$(cat "$SSID_FILE"))"
	fi
	# 常驻轮询（后台；stdout 重定向防止持有调用方会话）
	(
		while :; do
			sleep "$INTERVAL"
			if [ -f "$SSID_FILE" ] && [ -f "$WPA" ] && ! check; then
				log "检测到白名单外网络配置，重建并重启 WiFi"
				regen
				/etc/init.d/S30wifi restart >/dev/null 2>&1
				sleep 6
			fi
		done
	) >/dev/null 2>&1 &
	echo $! > /var/run/wifiguard.pid
	echo "wifiguard: 启动 (pid $!)"
}

stop() {
	if [ -f /var/run/wifiguard.pid ]; then
		kill "$(cat /var/run/wifiguard.pid)" 2>/dev/null
		rm -f /var/run/wifiguard.pid
	fi
	for p in $(ps -ef | grep "[S]98wifiguard" | awk "{print \$1}"); do
		kill "$p" 2>/dev/null
	done
	echo "wifiguard: 已停止"
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart) stop; sleep 0.3; start ;;
	*) echo "用法: $0 start|stop|restart"; exit 1 ;;
esac
