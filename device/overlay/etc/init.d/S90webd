#!/bin/sh
# S90webd — LicheeRV 后台管理系统 Web 服务自启
# 依赖 S90ewelink（ewelink daemon 先于 webd 启动，socket 集成）
# 重跑：/etc/init.d/S90webd start|stop|restart

# 自动控制(喂狗)配置: 环境变量可覆盖; 启用后在板端 /etc/webd.env 中修改
# 注: 狗窗口(1.2s)与置信度阈值(65%)是 webd 代码内固定常量(control.rs), 无对应环境变量
# WEB_CTRL_ENABLED=1            启用/禁用
# WEB_CTRL_QUOTA=1              每日配额次数
# WEB_CTRL_REFRESH_HOUR=6       每日刷新时间(点, 默认东八区)
# WEB_CTRL_TZ=+0800             配额时区
# WEB_CTRL_SOCKET_SECONDS=10    插座通电秒数
# WEB_CTRL_SOCKET_ID=           插座 deviceid(留空=缓存第一个)
[ -f /etc/webd.env ] && . /etc/webd.env
: ${WEB_CTRL_ENABLED:=1}; export WEB_CTRL_ENABLED
: ${WEB_CTRL_QUOTA:=1}; export WEB_CTRL_QUOTA
: ${WEB_CTRL_REFRESH_HOUR:=6}; export WEB_CTRL_REFRESH_HOUR
: ${WEB_CTRL_TZ:=+0800}; export WEB_CTRL_TZ
: ${WEB_CTRL_SOCKET_SECONDS:=10}; export WEB_CTRL_SOCKET_SECONDS
: ${WEB_CTRL_SOCKET_ID:=}; export WEB_CTRL_SOCKET_ID

DAEMON=/mnt/system/usr/bin/webd
LOG=/var/log/webd.log
PIDFILE=/var/run/webd.pid
# S96vision watchdog 兼管 webd 保活; 手动 stop 时写此标记, 防止被自动拉起
MANAGED_OFF=/var/run/webd.managed-off

start() {
	rm -f "$MANAGED_OFF"
	if [ ! -x "$DAEMON" ]; then
		echo "webd: $DAEMON 不存在，跳过"
		return 1
	fi
	if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
		echo "webd: 已在运行 (pid $(cat "$PIDFILE"))"
		return 0
	fi
	# 后台拉起；HOME 固定 /root（与 ewelink daemon socket 路径一致）
	HOME=/root "$DAEMON" >>"$LOG" 2>&1 &
	echo $! >"$PIDFILE"
	echo "webd: 启动 (pid $!)"
	# 健康探测（≤5s）
	i=0
	while [ $i -lt 50 ]; do
		if wget -q -O /dev/null "http://127.0.0.1:8080/api/health" 2>/dev/null; then
			echo "webd: HTTP 就绪"
			return 0
		fi
		sleep 0.1
		i=$((i + 1))
	done
	echo "webd: HTTP 未就绪（检查 $LOG）"
	return 1
}

stop() {
	: > "$MANAGED_OFF"
	if [ -f "$PIDFILE" ]; then
		kill "$(cat "$PIDFILE")" 2>/dev/null
		rm -f "$PIDFILE"
	fi
	pkill -f '[w]ebd' 2>/dev/null
	sleep 0.5
	echo "webd: 已停止"
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart) stop; sleep 0.3; start ;;
	*) echo "用法: $0 start|stop|restart"; exit 1 ;;
esac