# 板端 eWelink 凭证（S90ewelink 以 set -a 方式 source）
# 部署时复制为 /etc/ewelink.env 并填入真实值
EWELINK_APPID=your_appid
EWELINK_APPSECRET=your_app_secret
EWELINK_ACCOUNT=+8613800138000
EWELINK_PASSWORD=your_password
EWELINK_COUNTRY_CODE=+86
EWELINK_REGION=cn
EWELINK_REDIRECT_URL=https://your.redirect.url/callback
